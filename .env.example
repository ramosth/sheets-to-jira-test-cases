# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha com os dados do SEU ambiente.
# O .env está no .gitignore e nunca deve ser versionado.
# ---------------------------------------------------------------------------

# --- Jira Cloud ---
JIRA_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=seu.email@empresa.com
# Gere em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu_token_de_api

# Projeto onde os casos de teste serão criados (ex.: QA -> QA-123)
PROJECT_KEY=QA

# ID do tipo de issue "Caso de Teste" (GET /rest/api/3/issuetype)
JIRA_ISSUE_TYPE_ID=10000
# Nome do tipo de vínculo entre história e caso de teste
JIRA_LINK_TYPE_NAME=Casos de Teste

# IDs dos campos personalizados (GET /rest/api/3/field). Deixe em branco os que não existirem.
JIRA_FIELD_TIPO_EXECUCAO=customfield_10001
JIRA_FIELD_TIPO_TESTE=customfield_10002
JIRA_FIELD_OBJETIVO=customfield_10003
JIRA_FIELD_PRE_CONDICOES=customfield_10004

# Nomes das transições do workflow aplicadas após a criação
TRANSICAO_A_ESCREVER=To write
TRANSICAO_A_AUTOMATIZAR=To automate

# --- Google Sheets ---
# Trecho da URL da planilha entre /d/ e /edit
SPREADSHEET_ID=id_da_sua_planilha
